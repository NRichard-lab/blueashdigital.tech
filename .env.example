# Production environment template. Keep real values outside Git.

APP_ENV=production
APP_NAME=Blue Ash Digital Portal
APP_DOMAIN=blueashdigital.tech
FRONTEND_ORIGIN=https://blueashdigital.tech
CORS_ORIGINS=https://blueashdigital.tech,https://www.blueashdigital.tech
COOKIE_DOMAIN=.blueashdigital.tech

POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=
DATABASE_URL=

SECRET_KEY=
SESSION_SECRET=
SESSION_COOKIE_NAME=blueash_session
PRE_AUTH_COOKIE_NAME=blueash_pre_auth
SESSION_MAX_AGE_SECONDS=28800

VITE_API_BASE_URL=https://api.blueashdigital.tech
DEPLOYMENT_VERSION=

EMAIL_ENCRYPTION_KEY=
EMAIL_FROM=no-reply@blueashdigital.tech

# Optional one-time bootstrap values. Remove them after the administrator exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# SOURCE_VERSION is deprecated and intentionally unused. Use DEPLOYMENT_VERSION.

