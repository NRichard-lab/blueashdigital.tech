# Production environment template. Keep real values outside Git.

APP_ENV=production
APP_NAME=Blue Ash Digital Portal
APP_DOMAIN=blueashdigital.tech
FRONTEND_ORIGIN=https://blueashdigital.tech
CORS_ORIGINS=https://blueashdigital.tech,https://www.blueashdigital.tech

POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=
DATABASE_URL=

SECRET_KEY=
SESSION_SECRET=
SESSION_COOKIE_NAME=__Host-blueash_portal_session
PRE_AUTH_COOKIE_NAME=__Host-blueash_pre_auth
SESSION_MAX_AGE_SECONDS=28800

OPPORTUNITY_RADAR_CLIENT_ID=opportunity-radar
OPPORTUNITY_RADAR_CLIENT_SECRET=
OPPORTUNITY_RADAR_PUBLIC_ORIGIN=https://radar.blueashdigital.tech
OPPORTUNITY_RADAR_CALLBACK_URI=https://radar.blueashdigital.tech/api/auth/callback
APPLICATION_AUTH_CODE_TTL_SECONDS=60
APPLICATION_SESSION_IDLE_SECONDS=1800
APPLICATION_SESSION_ABSOLUTE_MAX_SECONDS=28800
APPLICATION_AUTH_CLEANUP_RETENTION_SECONDS=86400

VITE_API_BASE_URL=https://api.blueashdigital.tech
VITE_RADAR_PUBLIC_ORIGIN=https://radar.blueashdigital.tech
DEPLOYMENT_VERSION=

EMAIL_ENCRYPTION_KEY=
EMAIL_FROM=no-reply@blueashdigital.tech

# Optional one-time bootstrap values. Remove them after the administrator exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# SOURCE_VERSION is deprecated and intentionally unused. Use DEPLOYMENT_VERSION.

