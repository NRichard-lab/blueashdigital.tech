APP_ENV=production
APP_NAME=Blue Ash Digital Portal
APP_DOMAIN=blueashdigital.tech
FRONTEND_ORIGIN=https://blueashdigital.tech
COOKIE_DOMAIN=.blueashdigital.tech

POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://portal:change-me@postgres:5432/portal

SECRET_KEY=replace-with-a-strong-random-secret
SESSION_SECRET=replace-with-a-different-strong-random-secret
SESSION_COOKIE_NAME=blueash_session
SESSION_MAX_AGE_SECONDS=28800

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@blueashdigital.tech

