# Local development only. These values are intentionally not production-safe.
APP_ENV=development
APP_NAME=Blue Ash Digital Portal
APP_DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal-dev-password
DATABASE_URL=postgresql+psycopg://portal:portal-dev-password@postgres:5432/portal

SECRET_KEY=dev-only-secret-key-not-for-production
SESSION_SECRET=dev-only-session-secret-not-for-production
SESSION_COOKIE_NAME=blueash_session
PRE_AUTH_COOKIE_NAME=blueash_pre_auth
SESSION_MAX_AGE_SECONDS=28800

OPPORTUNITY_RADAR_CLIENT_ID=opportunity-radar
OPPORTUNITY_RADAR_CLIENT_SECRET=dev-only-opportunity-radar-client-secret-1234567890
OPPORTUNITY_RADAR_PUBLIC_ORIGIN=https://radar.localhost
OPPORTUNITY_RADAR_CALLBACK_URI=https://radar.localhost/api/auth/callback
APPLICATION_AUTH_CODE_TTL_SECONDS=60
APPLICATION_SESSION_IDLE_SECONDS=1800
APPLICATION_SESSION_ABSOLUTE_MAX_SECONDS=28800
APPLICATION_AUTH_CLEANUP_RETENTION_SECONDS=86400

VITE_API_BASE_URL=http://localhost:8000
VITE_RADAR_PUBLIC_ORIGIN=https://radar.localhost
DEPLOYMENT_VERSION=local-dev

EMAIL_ENCRYPTION_KEY=dev-only-email-key-not-for-production
EMAIL_FROM=no-reply@localhost
