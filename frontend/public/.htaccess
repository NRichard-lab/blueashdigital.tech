<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never rewrite API requests into the frontend application.
  RewriteRule ^api(?:/|$) - [L]

  # Serve existing assets and directories without rewriting them.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Let the React application handle client-side routes.
  RewriteRule ^ index.html [L]
</IfModule>
